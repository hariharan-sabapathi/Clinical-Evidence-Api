# Copy to .env and fill in real values for local development.
# `docker compose up` already supplies working defaults for everything
# below via docker-compose.yml -- this file is for running the API
# directly (uvicorn app.main:app) outside of Docker, or for overriding
# one setting (most commonly LLM_MODEL/LLM_API_KEY) without editing
# docker-compose.yml itself.

APP_ENV=development

# --- Database (two roles -- see app/core/config.py and the README's
# "Authorization model" section for why) ---
DATABASE_URL=postgresql+asyncpg://clinical_runtime:runtimepassword@localhost:5432/clinical_evidence
DATABASE_URL_MIGRATOR=postgresql+asyncpg://clinical_app:devpassword@localhost:5432/clinical_evidence

# --- Redis (queue backend, rate limiter) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-secret

# --- LLM serving ---
# Leave LLM_MODEL unset (or "not-configured") to run in retrieval-only
# mode -- no external call is made, /query returns ranked, cited evidence
# with "answer": null. Set both to enable generation.
LLM_MODEL=not-configured
LLM_API_KEY=
